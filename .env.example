# Copy to .env and adjust. All keys are optional for local development.

# ─── App runtime ──────────────────────────────────────────────────────────
# Enables product-link scraping (image + title) via https://jsonlink.io.
# Leave blank to disable scraping.
JSONLINK_API_KEY=

# Port the Express server listens on (serves the API and, in production, the
# built frontend). Defaults to 3001 if unset.
PORT=3001

# ─── Deployment target (deploy.sh, setup-certs.sh) ────────────────────────
# SSH host/IP and user for the machine you deploy to.
PI_HOST=192.0.2.10
PI_USER=pi

# ─── TLS via Let's Encrypt (setup-certs.sh) ───────────────────────────────
# Public domain the app is served at, and the contact email for Let's Encrypt.
DOMAIN=registry.example.com
CERTBOT_EMAIL=you@example.com

# Route53 credentials for the DNS-01 challenge (IAM user limited to the zone).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
