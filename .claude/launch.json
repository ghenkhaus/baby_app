{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "baby-registry-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 5173,
      "autoPort": true
    },
    {
      "name": "baby-registry-server",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "server"],
      "port": 3001
    },
    {
      "name": "baby-registry-preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "preview", "--", "--port", "4173"],
      "port": 4173,
      "autoPort": true
    }
  ]
}
